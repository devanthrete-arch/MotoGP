{
  "name": "autoflex-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "api:dev": "tsx server-ts/index.ts",
    "api:start": "tsx server-ts/index.ts",
    "dev": "vite --host 0.0.0.0 --port 8080",
    "build": "tsc -b && vite build && node scripts/build-service-worker.mjs",

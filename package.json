    "@vitejs/plugin-react": "^4.3.4",
    "dompurify": "^3.4.16",
    "fastify": "^5.10.0",
    "lucide-react": "^1.51.0",
    "marked": "^18.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.18.4",

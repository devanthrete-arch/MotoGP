{
  "buildCommand": "npm run build",
  "cleanUrls": true,
  "framework": "vite",
  "headers": [
    {
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co; font-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data: blob:; object-src 'none'; script-src 'self'; style-src 'self'; upgrade-insecure-requests"
        }
      ],
      "source": "/(.*)"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ],
      "source": "/assets/(.*)"
    },
    {
      "headers": [
        {
          "key": "Vary",
          "value": "User-Agent"
        }
      ],
      "source": "/((?!assets/|.*\\..*).*)"
    }
  ],
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "destination": "/api/og?path=/:path",
      "has": [
        {
          "key": "user-agent",
          "type": "header",
          "value": ".*([Ff]acebookexternalhit|Facebot|[Tt]witterbot|LinkedInBot|[Ss]lackbot|Slack-ImgProxy|[Dd]iscordbot|[Ww]hats[Aa]pp|TelegramBot|Pinterest|redditbot|Applebot|SkypeUriPreview|Embedly|Iframely|[Mm]astodon|vkShare|Snapchat|Flipboard|Tumblr|Nuzzel|Qwantify|bitlybot|Google-Read-Aloud).*"
        }
      ],
      "missing": [
        {
          "key": "og",
          "type": "query"
        }
      ],
      "source": "/:path((?!api/|assets/|.*\\..*).*)"
    },
    {
      "destination": "/index.html",
      "source": "/((?!assets/|.*\\..*).*)"
    }
  ]
}
